# ============================================================
# Root-level .gitignore for the International Payment System
# ============================================================

# Environment / Secrets — NEVER commit these
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/

# SQLite databases (runtime data — not source code)
*.db
*.sqlite
*.sqlite3

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db

# Output directory
output/

# Screen recording scripts
record_walkthrough.py
